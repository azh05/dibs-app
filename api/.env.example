ANTHROPIC_API_KEY=sk-ant-...
# Optional: any model that supports the web search tool
DIBS_MODEL=claude-opus-5-5

# Bright Data (for /extract/serp and /extract/instagram)
BRIGHTDATA_API_KEY=
# SERP API or Web Unlocker zone name. Leave blank to use the account's first serp/unblocker zone.
BRIGHTDATA_SERP_ZONE=

# Apify (for /extract/shops): console.apify.com -> Settings -> API & Integrations
APIFY_TOKEN=
# Google Maps shop-list cache file (default api/.cache/shops.json); "off" disables it
# DIBS_SHOP_CACHE=off

# Elastic Serverless (search, Ask dibs agent, workflows). Project home -> Connection details; Admin -> API keys
ELASTIC_URL=
KIBANA_URL=
ELASTIC_API_KEY=

# Shared key for callers outside this machine (Elastic workflows, Convex): they send it as X-Dibs-Key.
# Leave unset for local-only use.
# DIBS_API_KEY=
